# ══════════════════════════════════════════════════════════════
# AgentFlow .env.example — 脱敏模板（可提交到 git）
# 使用方法：cp .env.example .env 然后填入真实值
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# OpenClaw 大模型 API 网关
# ──────────────────────────────────────────────
OPENCLAW_BASE_URL=https://api.openclaw.ai/v1
OPENCLAW_API_KEY=your_openclaw_api_key_here

# ──────────────────────────────────────────────
# PM 部门 钉钉 Webhook
# ──────────────────────────────────────────────
DINGTALK_WEBHOOK_PM=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
DINGTALK_WEBHOOK_PM_SECRET=

# ──────────────────────────────────────────────
# 钉钉 应用机器人 — 各部门
# ──────────────────────────────────────────────
DINGTALK_MAIN_CLIENT_ID=dingXXXXXXXXXXXXXXXX
DINGTALK_MAIN_CLIENT_SECRET=your_secret_here
DINGTALK_MAIN_MODEL=claude-sonnet-4-6

DINGTALK_AFTERSALE_CLIENT_ID=dingXXXXXXXXXXXXXXXX
DINGTALK_AFTERSALE_CLIENT_SECRET=your_secret_here
DINGTALK_AFTERSALE_MODEL=gemini-3.1-pro-preview

DINGTALK_SALES_CLIENT_ID=dingXXXXXXXXXXXXXXXX
DINGTALK_SALES_CLIENT_SECRET=your_secret_here
DINGTALK_SALES_MODEL=gemini-3.1-pro-preview

DINGTALK_HR_CLIENT_ID=dingXXXXXXXXXXXXXXXX
DINGTALK_HR_CLIENT_SECRET=your_secret_here
DINGTALK_HR_MODEL=gemini-3.1-pro-preview

DINGTALK_PM_CLIENT_ID=dingXXXXXXXXXXXXXXXX
DINGTALK_PM_CLIENT_SECRET=your_secret_here
DINGTALK_PM_MODEL=qwen3-coder-plus

# ──────────────────────────────────────────────
# 飞书 应用机器人 — 各部门
# ──────────────────────────────────────────────
FEISHU_DATAANALYST_APP_ID=cli_XXXXXXXXXXXX
FEISHU_DATAANALYST_APP_SECRET=your_secret_here
FEISHU_DATAANALYST_MODEL=qwen3.5-plus

FEISHU_TESTER_APP_ID=cli_XXXXXXXXXXXX
FEISHU_TESTER_APP_SECRET=your_secret_here
FEISHU_TESTER_MODEL=claude-sonnet-4-6

FEISHU_MAIN_APP_ID=cli_XXXXXXXXXXXX
FEISHU_MAIN_APP_SECRET=your_secret_here
FEISHU_MAIN_MODEL=claude-sonnet-4-6

FEISHU_PM_APP_ID=cli_XXXXXXXXXXXX
FEISHU_PM_APP_SECRET=your_secret_here
FEISHU_PM_MODEL=qwen3-coder-plus

FEISHU_SALES_APP_ID=cli_XXXXXXXXXXXX
FEISHU_SALES_APP_SECRET=your_secret_here
FEISHU_SALES_MODEL=gemini-3.1-pro-preview

# ──────────────────────────────────────────────
# 飞书 Webhook（自定义机器人，用于群播）
# ──────────────────────────────────────────────
FEISHU_WEBHOOK_URL=

